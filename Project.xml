<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- _________________________ Application Settings _________________________ -->

	<app title="VS IMPOSTOR LEGACY" file="ImpostorLegacy" packageName="com.motorfrog.impostor" package="com.motorfrog.impostor" main="Main" version="0.2.7" company="MotorFrog" />

	<!--Switch Export with Unique ApplicationID and Icon-->
	<set name="APP_ID" value="0x0100f6c013bbc000" />

	<!-- NOTE TO SELF: DISABLE THIS IF ISSUES ARE FOUND -->
	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB"/>
	<!-- stable luas PUT AFTER FIRST LINE WITH APP NAME AND ETC -->

	<!--Use the HaxeFlixel loading screen on native targets and HTML5 too. -->
	<!-- Use the real HaxeFlixel loading screen now that the default library contains only startup/menu assets. -->
		<!-- HTML5 uses the in-app real asset loader; native targets keep the HaxeFlixel preloader. -->
	<app preloader="flixel.system.FlxPreloader" unless="html5" />

	<!--Minimum without FLX_NO_GAMEPAD: 11.8, without FLX_NO_NATIVE_CURSOR: 11.2-->
	<set name="SWF_VERSION" value="11.8" />

	<!-- ____________________________ Window Settings ___________________________ -->

	<!--These window settings apply to all targets-->
	<window width="1280" height="720" fps="60" background="#000000" hardware="true" vsync="false" allow-high-dpi="true" />

	<!--Desktop-specific-->
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" vsync="false"/>

	<!--Mobile-specific-->
	<window if="mobile" orientation="landscape" fullscreen="true" width="0" height="0" resizable="false"/>

	<!--Switch-specific-->
	<window if="switch" orientation="landscape" fullscreen="true" width="0" height="0" resizable="true" />

	<!-- _____________________________ Engine Config Settings ____________________________ -->

	<!--ENGINE CUSTOMIZATION-->
	<define name="MODS_ALLOWED" if="desktop" />
	<define name="VIDEOS_ALLOWED" if="cpp" />
	<define name="DISCORD_ALLOWED" if="cpp"/>

	<!-- _____________________________ Path Settings ____________________________ -->

	<classpath name="source" />

	<!--Fixes hxvlc using global rather than local. you will need to use hmm/hxpkg to compile this project though-->
	<setenv name="HAXEPATH" value="./"/>

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bits" />
	<set name="BUILD_DIR" value="${BUILD_DIR}-tracy" if="FEATURE_DEBUG_TRACY"/>

	<assets path="LEGACY.md" rename="CHANGELOG.md"/>
	<assets path="content/mods-go-here.txt"/>
	
	<section unless="ASSET_REDIRECT">
		<log info="INCLUDING ASSETS!!" />
		<log info="INCLUDING DLC!!" if="DLC" />

		<!-- Keep the startup library limited to only what the title and main menu actually need. -->
		<assets path="assets/legacy/data" rename="assets/data" library="startup" include="introText.txt" />
		<assets path="assets/legacy/lang" rename="assets/lang" library="startup" include="english.json" />
		<assets path="assets/legacy/sounds" rename="assets/sounds" library="startup"
			include="confirmMenu.ogg|cancelMenu.ogg|scrollMenu.ogg" />
		<assets path="assets/legacy/music" rename="assets/music" library="startup"
			include="freakyMenu.ogg|finaleMenu.ogg" />
		<assets path="assets/legacy/fonts" rename="assets/fonts" library="startup"
			include="vcr.ttf|vcr-srb.ttf" />

		<!-- Title screen assets. -->
		<assets path="assets/legacy/images" rename="assets/images" library="startup"
			include="logoBumpin.png|logoBumpin.xml|cursor.png" />
		<assets path="assets/legacy/images/menu/common" rename="assets/images/menu/common" library="startup" />
		<assets path="assets/legacy/images/menu/title" rename="assets/images/menu/title" library="startup" />
		<assets path="assets/legacy/images/menu/main" rename="assets/images/menu/main" library="startup"
			include="redmenu.png|redmenu.xml|greenmenu.png|greenmenu.xml|glow.png|glowEVIL.png|vignette.png|tablet.png|new buttons and stuff.png|new buttons and stuff.xml|shiny.png|shiny.xml" />

		<!-- Everything else is copied into separate libraries and is NOT loaded during startup. -->
		<assets path="assets/legacy/data" rename="assets/data" library="gameplay"
			exclude="introText.txt" />
		<assets path="assets/legacy/lang" rename="assets/lang" library="gameplay"
			exclude="english.json" />
		<assets path="assets/legacy/scripts" rename="assets/scripts" library="gameplay" />
		<assets path="assets/legacy/shaders" rename="assets/shaders" library="gameplay" />

		<assets path="assets/embeds" rename="assets" library="embedded" embed="true" />
		<!-- HTML5 never uses the native video backend; keep video manifests out of startup. -->
		<assets path="assets/legacy/videos" rename="assets/videos" library="embedded" if="html5" />
		<assets path="content/securitydlc" rename="content/securitydlc" library="embedded" embed="false" if="DLC" />

		<assets path="assets/legacy/images" rename="assets/images" library="gameplay" if="html5"
			exclude="menu*|icons*|awards*|logoBumpin.png|logoBumpin.xml|cursor.png" />
		<assets path="assets/legacy/sounds" rename="assets/sounds" library="gameplay"
			exclude="confirmMenu.ogg|cancelMenu.ogg|scrollMenu.ogg" />

		<assets path="assets/legacy/music" rename="assets/music" library="music"
			exclude="freakyMenu.ogg|finaleMenu.ogg" />
		<assets path="assets/legacy/songs" rename="assets/songs" library="music" />

		<assets path="assets/legacy/fonts" rename="assets/fonts" library="fonts"
			exclude="vcr.ttf|vcr-srb.ttf" />

		<!-- The default library is deliberately empty; HTML5 loads the small startup library explicitly. -->
		<library name="default" preload="false" />
		<library name="startup" preload="false" />
		<library name="embedded" preload="false" />
		<library name="gameplay" preload="false" />
		<library name="music" preload="false" />
		<library name="fonts" preload="false" />
	</section>

	<!--OpenAL config-->	<!-- appreciate you cyn0x8 and smokey for finding this -->
	<section if="desktop">
		<assets path="projFiles/alsoft.ini" rename="alsoft.ini" type="text" if="windows"/>
		<assets path="projFiles/alsoft.ini" rename="alsoft.conf" unless="windows"/>
	</section>

	<!-- _______________________________ Haxe libraries ______________________________ -->

	<!--Core engine libraries-->
	<haxelib name="openfl"/>

	<haxelib name="flixel"/>
	<haxelib name="flixel-addons"/>
	<haxelib name="flixel-ui" version="2.6.4"/>

	<haxelib name="hscript-iris"/>

	<haxelib name="flixel-animate"/>
	<haxelib name="moonchart"/>

	<haxelib name="haxeui-core" />
	<haxelib name="haxeui-flixel" />

	<haxelib name="funkin.vis"/>
	<haxelib name="grig.audio"/>
	<haxelib name="json2object"/>
	<haxelib name="json5hx"/>

	<haxelib name="hxdiscord_rpc" if="DISCORD_ALLOWED" version="1.2.4"/>
	<haxelib name="hxvlc" if="VIDEOS_ALLOWED"/>

	<!-- _______________ macros ... oh theres so many ... save me ... _______________ -->

	<haxeflag name="--macro" value="addMetadata('@:build(funkin.backend.macro.FlxMacro.buildFlxSprite())', 'flixel.FlxSprite')" />
	<haxeflag name="--macro" value="addMetadata('@:build(funkin.backend.macro.FlxMacro.buildFlxCamera())', 'flixel.FlxCamera')" />
	<haxeflag name="--macro" value="addMetadata('@:build(funkin.backend.macro.FlxMacro.buildFlxText())', 'flixel.text.FlxText')" />
	<haxeflag name="--macro" value="addMetadata('@:build(funkin.backend.macro.FlxMacro.buildFlxGraphic())', 'flixel.graphics.FlxGraphic')" />
	<haxeflag name="--macro" value="addMetadata('@:build(funkin.backend.macro.FlxMacro.buildFlxDrawBaseItem())', 'flixel.graphics.tile.FlxDrawBaseItem')" />
	<haxeflag name="--macro" value="addMetadata('@:build(funkin.backend.macro.FlxMacro.buildFlxDrawItem())', 'flixel.graphics.tile.FlxDrawQuadsItem')" />
	<haxeflag name="--macro" value="addMetadata('@:build(funkin.backend.macro.FlxMacro.buildFlxDrawItem())', 'flixel.graphics.tile.FlxDrawTrianglesItem')" />
	
	<haxeflag name="--macro" value="addMetadata('@:nullSafety(Off)', 'hxvlc.openfl.Video')" if="VIDEOS_ALLOWED"/>

	<haxeflag name="--macro" value="include('funkin')" />
	<haxeflag name="--macro" value="include('flixel', true, ['flixel.addons.nape.*','flixel.addons.editors.*','flixel.addons.tile.FlxRayCastTilemap','flixel.system.macros'])" />

	<haxeflag name="-dce no" />

	<!-- ______________________________ Haxedefines _____________________________ -->

	<haxedef name="analyzer-optimize" unless='debug'/>

	<haxedef name="haxeui_dont_impose_base_class"/>
	<haxedef name="haxeui_focus_out_on_click"/>

	<!--Needed for better error reporting with hscript-->
	<define name="hscriptPos"/>

	<!--Tracy profiler stuff-->
	<section if="FEATURE_DEBUG_TRACY">
		<haxedef name="HXCPP_TELEMETRY"/>
		<haxedef name="HXCPP_TRACY"/>
		<haxedef name="HXCPP_TRACY_MEMORY"/>
		<haxedef name="HXCPP_TRACY_ON_DEMAND"/>
		<haxedef name="absolute-paths"/>
		<!-- <haxedef name="HXCPP_TRACY_INCLUDE_CALLSTACKS"/> -->
	</section>

	<!--Enable for better crash handling/reporting-->
	<haxedef name="CRASH_HANDLER"/>

	<haxedef name="HXCPP_CHECK_POINTER" if="CRASH_HANDLER"/>
	<haxedef name="HXCPP_STACK_LINE" if="CRASH_HANDLER"/>
	<haxedef name="HXCPP_STACK_TRACE" if="CRASH_HANDLER"/>
	<haxedef name="openfl-enable-handle-error" if="CRASH_HANDLER"/>

	<!--Disables all tracing abilities. Enable this for a small performance improvement-->
	<!-- <define name="DISABLE_TRACES" if="desktop release"/> -->

	<!--Remove the legacy health system-->
	<haxedef name="FLX_NO_HEALTH" />

	<!--Disable the Flixel core focus lost screen-->
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />

	<!--Disable the Flixel core debugger. Automatically gets set whenever you compile in release mode!-->
	<haxedef name="FLX_NO_DEBUG" unless="debug" />

	<!--Enable this for Nape release builds for a serious peformance improvement-->
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />

	<!--For haxe 4.3.0 and newer cleaner error reporting-->
	<haxedef name="message.reporting" value="pretty" />

	<!--For Haxe 4.3.0 and newer disables warnings-->
	<haxedef name="no-deprecation-warnings"/>

	<!-- _________________________________ Custom _______________________________ -->

	<icon path="projFiles/icon/icon16.png" size='16'/>
	<icon path="projFiles/icon/icon32.png" size='32'/>
	<icon path="projFiles/icon/icon64.png" size='64'/>
	<icon path="projFiles/icon/iconOG.png" />
</project>
